/**
 * The human face of Train Of Thought — same visual language as the SessionDiary index
 * (http://127.0.0.1:8134/site/read_dir_indexer.html): one mono typeface, #0d1117 ground,
 * hairline rules, dim columns, a single accent, chips for tags. No shadows, no gradients.
 *
 * Routes that use this: GET /  ·  GET /t/<ref>  ·  GET /archive
 */

import type { ThoughtNode } from './types.js';
import { claimLive, depsSettled, layers } from './dag.js';
import type { ThoughtStore } from './store.js';
import type { SessionCard } from './sessionClient.js';

export const CSS = `
  :root{
    --bg:#0d1117; --bg2:#11161d; --line:#1e2732; --rule:#141b23;
    --text:#d8dee9; --dim:#6b7785; --accent:#8fb3d9; --warn:#d9a88f; --ok:#8fd9a8;
    --mono:ui-monospace,SFMono-Regular,"Cascadia Mono",Consolas,monospace;
  }
  *{box-sizing:border-box}
  html,body{margin:0;background:var(--bg);color:var(--text)}
  body{font:15px/1.55 var(--mono);padding:34px clamp(18px,5vw,64px) 80px;max-width:1220px;margin:0 auto}
  a{color:inherit;text-decoration:none}
  a:hover .t{text-decoration:underline}
  h1{font-size:26px;font-weight:500;letter-spacing:-.01em;margin:6px 0 8px;line-height:1.25}
  h2{font-size:12px;text-transform:uppercase;letter-spacing:.14em;color:var(--dim);font-weight:600;margin:0 0 12px}
  .kicker{font-size:12px;color:var(--dim);letter-spacing:.04em}
  .sub{color:var(--dim);font-size:12.5px}
  .dim{color:var(--dim)}
  .masthead{margin-bottom:26px}

  /* the one thing to do next */
  .next{display:block;margin:0 0 24px;padding:16px 18px;border:1px solid var(--line);
        border-left:2px solid var(--accent);background:var(--bg2)}
  .next .label{font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent)}
  .next .t{display:block;margin:6px 0 2px;font-size:16px;color:#fff}
  .next .action{color:#c7d2df;font-size:13.5px}
  .next .why{margin-top:6px;font-size:11.5px;color:var(--dim)}
  .next.empty{border-left-color:var(--warn)}
  .next.empty .label{color:var(--warn)}

  /* controls */
  .controls{display:flex;gap:12px;align-items:center;margin:0 0 14px}
  input[type=search],input[type=text],textarea{width:100%;background:var(--bg2);border:1px solid var(--line);color:var(--text);
    font:13.5px var(--mono);padding:10px 12px;border-radius:4px;outline:none}
  input:focus,textarea:focus{border-color:#33506b}
  .controls input{max-width:360px}

  /* the table */
  .thead,.row{display:grid;grid-template-columns:46px minmax(190px,1.25fr) minmax(200px,1.5fr) 64px 88px 104px;gap:14px;align-items:baseline}
  .thead{font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);
         border-bottom:1px solid var(--line);padding:0 0 8px}
  .row{padding:9px 0;border-bottom:1px solid var(--rule);cursor:pointer}
  .row:hover{background:#10161e}
  .row.ready{box-shadow:inset 2px 0 0 var(--accent);padding-left:10px}
  .row .layer{font-size:11px;color:var(--dim);font-variant-numeric:tabular-nums}
  .row .t{color:var(--text);display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .row.ready .t{color:#fff}
  .row .tags{margin-top:4px;display:flex;gap:5px;flex-wrap:wrap}
  .tag{font-size:10.5px;border:1px solid var(--line);color:var(--dim);padding:0 6px;border-radius:10px}
  .row .action{color:var(--dim);font-size:12.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .row .num{color:var(--dim);font-size:11.5px;font-variant-numeric:tabular-nums;white-space:nowrap}
  .state{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--dim)}
  .state.active{color:var(--accent)}
  .state.blocked,.state.held{color:var(--warn)}
  .state.done{color:var(--ok)}

  /* archive */
  .archive{margin-top:46px}
  .archive .row{grid-template-columns:minmax(190px,1fr) 110px}
  .archive .summary{grid-column:1/-1;color:var(--dim);font-size:12.5px;margin-top:2px}

  /* thought page */
  .back{font-size:11.5px;color:var(--dim)}
  .back:hover{color:var(--accent)}
  .thought h1{margin:10px 0 6px;font-size:24px;font-weight:500;line-height:1.3;max-width:26ch}
  .intent{margin:18px 0 0;max-width:78ch;color:#c7d2df;font-size:14px;line-height:1.65}
  .grid2{display:grid;grid-template-columns:1.15fr .85fr;gap:44px;margin-top:38px}
  ol.steps{margin:0;padding:0;list-style:none;counter-reset:step}
  ol.steps li{counter-increment:step;padding:8px 0 8px 30px;position:relative;border-bottom:1px solid var(--rule);color:#c7d2df;font-size:13.5px}
  ol.steps li::before{content:counter(step);position:absolute;left:0;top:8px;font-size:11px;color:var(--dim)}
  ol.steps li:first-child{color:#fff}
  ol.steps li:first-child::before{color:var(--accent)}
  .chips{display:flex;gap:6px;flex-wrap:wrap}
  .chip{font-size:11.5px;color:var(--dim);border:1px solid var(--line);padding:2px 8px;border-radius:11px}
  .chip.done{color:var(--accent);border-color:#22303f}
  .chip:hover{color:var(--text);border-color:#2c3f52}
  .trail,.sessions{margin-top:40px}
  .entry{display:grid;grid-template-columns:118px 1fr;gap:16px;padding:8px 0;border-top:1px solid var(--rule);font-size:13px}
  .entry .when{color:var(--dim);font-size:11.5px;font-variant-numeric:tabular-nums}
  .entry .what{color:#c7d2df}
  .entry .kind{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--dim);margin-right:8px}
  .entry .by{color:var(--dim);font-size:11.5px}
  .card{padding:9px 0;border-top:1px solid var(--rule)}
  .card .t{color:var(--text);font-size:13.5px}
  .card .g{display:block;color:var(--dim);font-size:11.5px;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .card.down .t{color:var(--dim)}
  .acts{margin-top:34px;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
  button{font:11.5px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--dim);background:none;
    border:1px solid var(--line);padding:7px 12px;border-radius:3px;cursor:pointer;transition:color .12s,border-color .12s}
  button:hover{color:var(--text);border-color:#2c3f52}
  button.primary{color:var(--accent);border-color:#22303f}
  .noteform{margin-top:14px;display:grid;gap:8px;max-width:640px}
  textarea{resize:vertical;min-height:56px}
  .empty-note{color:var(--dim);font-size:12.5px;padding:8px 0}
  footer{margin-top:56px;font-size:11.5px;color:var(--dim)}
  footer a{color:var(--dim)} footer a:hover{color:var(--accent)}
  @media (max-width:760px){
    body{padding:24px 16px 64px}
    .thead{display:none}
    .row{grid-template-columns:26px 1fr;gap:8px}
    .row .num,.row .state,.row .action{grid-column:2}
    .grid2{grid-template-columns:1fr;gap:28px}
    .entry{grid-template-columns:1fr;gap:2px}
  }
`;

const esc = (text: string): string =>
  text.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch] ?? ch);

const stamp = (at: number): string => new Date(at).toISOString().slice(0, 16).replace('T', ' ');

const page = (title: string, body: string): string => `<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>${esc(title)}</title><style>${CSS}</style></head>
<body>${body}</body></html>`;

function nextBlock(store: ThoughtStore, ready: ThoughtNode[]): string {
  if (ready.length === 0) {
    const active = store.nodes.filter((node) => node.state === 'active').length;
    const waiting = store.nodes.filter((node) => node.state === 'active' && !depsSettled(store.nodes, node).ok).length;
    const claimed = store.nodes.filter((node) => claimLive(node, store.now)).length;
    const empty = store.nodes.filter((node) => node.state === 'active' && node.next.length === 0).length;
    const parked = store.nodes.filter((node) => node.state === 'blocked' || node.state === 'parked').length;
    const why = [
      `${active} active`,
      waiting ? `${waiting} waiting on deps` : '',
      claimed ? `${claimed} claimed` : '',
      empty ? `${empty} with no next action` : '',
      parked ? `${parked} parked or blocked` : '',
    ].filter(Boolean).join(' · ');
    return `<div class="next empty"><div class="label">nothing ready</div>
      <div class="t">The frontier is empty</div>
      <div class="why">${esc(why || 'no nodes yet — add one')}</div></div>`;
  }
  const top = ready[0];
  const rest = ready.length - 1;
  return `<div class="next"><div class="label">next</div>
    <a href="/t/${esc(top.ref)}"><span class="t">${esc(top.title)}</span></a>
    <div class="action">${esc(top.next[0] ?? '')}</div>
    <div class="why">${esc(top.ref)} · ${rest > 0 ? `${rest} more ready behind it` : 'the only ready train'}</div></div>`;
}

export function renderIndex(store: ThoughtStore, ready: ThoughtNode[]): string {
  const readyRefs = new Set(ready.map((node) => node.ref));
  const depth = layers(store.nodes);
  const live = store.nodes.filter((node) => node.state !== 'done');

  const rows = live
    .slice()
    .sort((a, b) => (depth.get(a.ref) ?? 0) - (depth.get(b.ref) ?? 0) || b.touched - a.touched)
    .map((node) => {
      const settled = depsSettled(store.nodes, node);
      const isReady = readyRefs.has(node.ref);
      const held = claimLive(node, store.now);
      const cls = held ? 'held' : node.state;
      return `<a class="row${isReady ? ' ready' : ''}" href="/t/${esc(node.ref)}" data-text="${esc(
        `${node.title} ${node.intent} ${node.tags.join(' ')} ${node.next.join(' ')}`.toLowerCase(),
      )}">
        <span class="layer">${depth.get(node.ref) ?? 0}</span>
        <span><span class="t">${esc(node.title)}</span>${
          node.tags.length ? `<span class="tags">${node.tags.map((tag) => `<span class="tag">${esc(tag)}</span>`).join('')}</span>` : ''
        }</span>
        <span class="action">${esc(node.next[0] ?? 'no next action')}</span>
        <span class="num">${settled.total === 0 ? 'root' : `${settled.done}/${settled.total}`}</span>
        <span class="state ${esc(cls)}">${esc(cls)}</span>
        <span class="num">${stamp(node.touched)}</span>
      </a>`;
    })
    .join('');

  const archived = store.nodes
    .filter((node) => node.state === 'done')
    .sort((a, b) => (b.closed?.at ?? 0) - (a.closed?.at ?? 0))
    .slice(0, 5)
    .map(
      (node) => `<a class="row" href="/t/${esc(node.ref)}">
        <span class="t">${esc(node.title)}</span>
        <span class="num">${stamp(node.closed?.at ?? node.touched)}</span>
        <span class="summary">${esc(node.closed?.summary ?? '')}</span>
      </a>`,
    )
    .join('');

  const archivedCount = store.nodes.filter((node) => node.state === 'done').length;

  const body = `
    <div class="masthead">
      <div class="kicker">Train of Thought · long-term intentions</div>
      <h1>${live.length} ${live.length === 1 ? 'train' : 'trains'} running</h1>
      <div class="sub">${store.nodes.length} nodes · ${ready.length} ready · ${archivedCount} archived · built ${stamp(store.now)}</div>
    </div>
    ${nextBlock(store, ready)}
    <div class="controls"><input type="search" id="filter" placeholder="filter trains…" autocomplete="off" spellcheck="false"></div>
    <div class="thead"><span>layer</span><span>thought</span><span>next action</span><span>deps</span><span>state</span><span>touched</span></div>
    <div id="rows">${rows || '<div class="empty-note">No trains yet — POST /api/thoughts to start one.</div>'}</div>
    ${
      archived
        ? `<div class="archive"><h2>Archived — done, and why</h2>${archived}
            <div class="sub" style="margin-top:12px"><a href="/archive" style="color:var(--dim)">all ${archivedCount} archived →</a></div></div>`
        : ''
    }
    <footer><a href="/api/next">/api/next</a> · <a href="/api/thoughts">/api/thoughts</a> · <a href="/api/archive">/api/archive</a></footer>
    <script>
      (function () {
        var box = document.getElementById('filter');
        if (!box) return;
        box.addEventListener('input', function () {
          var q = box.value.trim().toLowerCase();
          var rows = document.querySelectorAll('#rows .row');
          for (var i = 0; i < rows.length; i++) {
            var hit = !q || (rows[i].getAttribute('data-text') || '').indexOf(q) >= 0;
            rows[i].style.display = hit ? '' : 'none';
          }
        });
      })();
    </script>`;
  return page('Train Of Thought', body);
}

export function renderThought(store: ThoughtStore, node: ThoughtNode, cards: SessionCard[]): string {
  const settled = depsSettled(store.nodes, node);
  const held = claimLive(node, store.now);
  const depth = layers(store.nodes).get(node.ref) ?? 0;

  const steps = node.next.length
    ? `<ol class="steps">${node.next.map((line) => `<li>${esc(line)}</li>`).join('')}</ol>`
    : '<div class="empty-note">No next action recorded — a successor session would start cold.</div>';

  const deps = node.deps.length
    ? `<div class="chips">${node.deps
        .map((ref) => {
          const target = store.find(ref);
          return `<a class="chip${target?.state === 'done' ? ' done' : ''}" href="/t/${esc(ref)}">${esc(target?.title ?? ref)}</a>`;
        })
        .join('')}</div>`
    : '<div class="empty-note">Root of its train — nothing to wait for.</div>';

  const trail = node.trail
    .slice()
    .reverse()
    .map(
      (entry) => `<div class="entry"><div class="when">${stamp(entry.at)}</div>
        <div class="what"><span class="kind">${esc(entry.kind)}</span>${esc(entry.text)} <span class="by">· ${esc(entry.by)}</span></div></div>`,
    )
    .join('');

  const sessionCards = cards.length
    ? cards
        .map((card) =>
          card.ok
            ? `<div class="card"><span class="t">${esc(card.title ?? card.ref)}</span>
                 <span class="g">${esc(card.goal ?? '')}</span>
                 <span class="g">${esc(card.ref)} · ${card.messages ?? '?'} messages · ${esc(card.model ?? '')}</span></div>`
            : `<div class="card down"><span class="t">${esc(card.ref)}</span><span class="g">${esc(card.reason ?? 'session unavailable')}</span></div>`,
        )
        .join('')
    : '<div class="empty-note">No sessions attached yet.</div>';

  const actions = `
    <div class="acts">
      ${held ? `<button data-act="release" data-ref="${esc(node.ref)}">release ${esc(node.claimed?.by ?? '')}</button>` : `<button class="primary" data-act="claim" data-ref="${esc(node.ref)}">claim 30 min</button>`}
      <button data-act="state" data-ref="${esc(node.ref)}" data-state="parked">park</button>
      <button data-act="state" data-ref="${esc(node.ref)}" data-state="blocked">block</button>
      <button data-act="close" data-ref="${esc(node.ref)}">close…</button>
    </div>
    <div class="noteform">
      <textarea id="note" rows="2" placeholder="add a line to the trail…"></textarea>
      <div><button data-act="note" data-ref="${esc(node.ref)}">add note</button></div>
    </div>`;

  const closed = node.state === 'done' && node.closed
    ? `<div class="next" style="margin-top:34px"><div class="label">closed</div><div class="t">${esc(node.closed.summary)}</div>
        <div class="why">${stamp(node.closed.at)}</div></div>`
    : '';

  const body = `
    <div class="thought">
      <a class="back" href="/">← trains</a>
      <h1>${esc(node.title)}</h1>
      <div class="sub">${esc(node.ref)} · ${esc(node.state)}${held ? ` · held by ${esc(node.claimed?.by ?? '')}` : ''} · layer ${depth} · ${settled.total === 0 ? 'root' : `${settled.done}/${settled.total} deps`} · touched ${stamp(node.touched)}</div>
      <div class="intent">${esc(node.intent || 'No intent recorded yet — this node says what to do but not why.')}</div>
      ${closed}
      <div class="grid2">
        <div><h2>Next</h2>${steps}</div>
        <div><h2>Waits for</h2>${deps}</div>
      </div>
      ${actions}
      <div class="trail"><h2>Trail</h2>${trail || '<div class="empty-note">Nothing yet.</div>'}</div>
      <div class="sessions"><h2>Sessions</h2>${sessionCards}</div>
      <footer>${esc(node.ref)} · evidence lives in the session diary on :8134 · this page never writes to it</footer>
    </div>
    <script>
      function act(name, ref, extra) {
        fetch('/api/thoughts/' + ref + '/' + name, {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify(Object.assign({ by: 'user' }, extra || {})),
        }).then(function (r) { return r.json(); }).then(function (j) {
          if (!j.ok) { alert(j.error.code + ': ' + j.error.message); return; }
          location.reload();
        }).catch(function (e) { alert('request failed: ' + e.message); });
      }
      document.addEventListener('click', function (event) {
        var el = event.target.closest('button[data-act]');
        if (!el) return;
        var ref = el.getAttribute('data-ref'), what = el.getAttribute('data-act');
        if (what === 'note') {
          var box = document.getElementById('note');
          var text = ((box && box.value) || '').trim();
          if (!text) { alert('write something first'); return; }
          act('trail', ref, { kind: 'note', text: text });
        } else if (what === 'close') {
          var summary = prompt('Why is this train done? One line — it becomes the archive entry.');
          if (!summary) return;
          act('close', ref, { summary: summary });
        } else if (what === 'state') {
          act('state', ref, { state: el.getAttribute('data-state') });
        } else {
          act(what, ref, {});
        }
      });
    </script>`;
  return page(`${node.title} · Train Of Thought`, body);
}

export function renderArchive(store: ThoughtStore): string {
  const done = store.nodes.filter((node) => node.state === 'done').sort((a, b) => (b.closed?.at ?? 0) - (a.closed?.at ?? 0));
  const rows = done
    .map(
      (node) => `<a class="row" href="/t/${esc(node.ref)}">
        <span class="t">${esc(node.title)}</span>
        <span class="num">${stamp(node.closed?.at ?? node.touched)}</span>
        <span class="summary">${esc(node.closed?.summary ?? '')}</span>
      </a>`,
    )
    .join('');

  const body = `
    <a class="back" href="/">← trains</a>
    <div class="masthead" style="margin-top:18px">
      <div class="kicker">Archived</div>
      <h1>Done, and why</h1>
      <div class="sub">${done.length} closed ${done.length === 1 ? 'train' : 'trains'} · each line is the sentence that closed it</div>
    </div>
    ${rows || '<div class="empty-note">Nothing archived yet.</div>'}`;
  return page('Archived · Train Of Thought', body);
}
