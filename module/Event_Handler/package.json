{
  "name": "event-handler",
  "version": "0.1.0",
  "private": true,
  "description": "A GENERIC event handler (ES modules): register events, trigger them (fire-and-forget), and log everything to one rolling file. The magic that lets an agent track and execute — generic, for all projects.",
  "type": "module",
  "main": "public/js/main.js",
  "exports": {
    ".": "./public/js/main.js",
    "./client": "./public/js/client.js",
    "./handler": "./public/js/eventHandler.js",
    "./log": "./public/js/logStore.js",
    "./registry": "./public/js/mcpTools.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild public/ts/*.ts public/ts/browser/*.ts --outdir=public/js --format=esm --platform=node --target=node20 --sourcemap",
    "watch": "esbuild public/ts/*.ts public/ts/browser/*.ts --outdir=public/js --format=esm --platform=node --target=node20 --sourcemap --watch",
    "dev": "npm run watch",
    "typecheck": "tsc --noEmit",
    "selftest": "node public/js/selftest.js",
    "docs": "node scripts/build-docs.cjs",
    "test": "npm run build && npm run typecheck && npm run selftest",
    "start": "node public/js/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
