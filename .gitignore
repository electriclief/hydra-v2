# Hydra V2 — code and plans only.
# Runtime data never belongs in git: it is what each node generates, not what it is built from.
node_modules/
**/node_modules/

# runtime state, logs, process wrappers
logs/
**/logs/
*.log
module/ProcessWrapper/data/
module/SessionDiary/data/
data/standby/

# generated media and weights (immutable, huge, transported separately)
media/
docs/voice-samples/
*.gguf
*.safetensors
*.onnx
*.wav
*.mp3
*.mp4
*.zip
*.7z

# local editor/OS noise
.DS_Store
Thumbs.db
desktop.ini
*.bak
*.bak-*

# generated diary site (rebuilt from data by the door)
module/SessionDiary/site/

# the instance layer and runtime books: a node is not a clone of another node
module/Menu/data/node.json
module/Menu/data/models-cache.json
module/Scheduler/data/jobs.json
module/Core/data/*.log

# Echidna runtime: the conversation and its prompts are this node's, not the repo's
module/Echidna/data/thread.jsonl
module/Echidna/data/agent.json
module/Echidna/data/prompts/
module/Echidna/data/monitor.json

# ---- this LAN's data, by the operator's rule: the repo carries the code that stores the data, never the data ----
# (the one deliberate exception is a service definition, library/<name>/service.json, which is a contract)
fleet/
.shelf/
library/api-index.json
module/TrainOfThought/data/
module/Phoenix/data/

# Tell Mom receipts are this node's runtime history, not the repo's
module/TellMom/data/told.jsonl
module/Echidna/data/monitor.json
data/snapshots/
module/StateToFile/data/
module/StateFromFile/data/
